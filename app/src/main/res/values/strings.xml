    <string name="setup_title">Permissions</string>
    <string name="setup_intro">VowiDroid runs WiFi Calling with its own tunnel, IMS registration and SIP. From Android it only needs what is listed here.</string>
    <string name="setup_summary_all">Everything needed is granted</string>
    <string name="setup_summary">%1$d of %2$d needed permissions granted</string>
    <string name="setup_status_granted">Granted</string>
    <string name="setup_status_missing">Not granted</string>
    <string name="setup_optional">%1$s Optional.</string>
    <string name="setup_tap_hint">Tap an item to allow it. SIM access is granted once from root or a computer, as described above.</string>
    <string name="setup_phone_title">Phone</string>
    <string name="setup_phone_body">See which SIMs are in the phone.</string>
    <string name="setup_access_title">SIM access</string>
    <string name="setup_access_body">Read the SIM\'s IMSI and ICCID and let it answer the network\'s authentication challenge.</string>
    <string name="setup_access_unsupported">Using the phone\'s SIM needs Android 12 or newer. USB SIM readers still work.</string>
    <string name="setup_access_unsupported_short">Needs Android 12 or newer; USB SIM readers still work.</string>
    <string name="setup_access_help_title">Granting SIM access</string>
    <string name="setup_access_help_body">Android only lets root or a computer with adb grant this, once; it then stays granted until VowiDroid is uninstalled.</string>
    <string name="setup_root_action">Grant with root</string>
    <string name="setup_root_granted">SIM access granted.</string>
    <string name="setup_root_failed">Root did not grant SIM access. Use the adb command instead.</string>
    <string name="setup_adb_body">Without root, from a computer:\n1. On the phone, turn on Developer options (Settings → About phone, tap Build number seven times), then USB debugging.\n2. Connect the phone to a computer that has adb (Android platform-tools) and accept the USB debugging prompt on the phone.\n3. Run this command on the computer:</string>
    <string name="setup_adb_check">To check that it took, this prints \"allow\":</string>
    <string name="setup_adb_after">Then come back to VowiDroid; it checks the SIM again by itself.</string>
    <string name="setup_copy_action">Copy command</string>
    <string name="setup_copied">Command copied.</string>
    <string name="setup_notifications_title">Notifications</string>
    <string name="setup_notifications_body">Ring for incoming calls and show new texts.</string>
    <string name="setup_microphone_title">Microphone</string>
    <string name="setup_microphone_body">Your voice on calls.</string>
    <string name="setup_full_screen_title">Calls over the lock screen</string>
    <string name="setup_full_screen_body">Show an incoming call on a locked phone.</string>
    <string name="setup_battery_title">Unrestricted battery use</string>
    <string name="setup_battery_body">Keep the tunnel and the carrier registration alive while the screen is off.</string>
    <string name="setup_rom_title">%1$s background rules</string>
    <string name="setup_rom_one_ui_body">One UI puts apps to sleep on its own. Under Settings → Battery → Background usage limits, take VowiDroid out of Sleeping apps and Deep sleeping apps and add it to Never sleeping apps.</string>
    <string name="setup_rom_hyperos_body">Turn Autostart on for VowiDroid, and set its Battery saver to No restrictions under Settings → Apps → Manage apps → VowiDroid.</string>
    <string name="setup_rom_emui_body">Under Settings → Battery → App launch, manage VowiDroid manually with Auto-launch, Secondary launch and Run in background on.</string>
    <string name="setup_rom_coloros_body">Under Settings → Battery → App battery management (or Apps → App management → VowiDroid → Battery), allow background activity and auto launch.</string>
    <string name="setup_rom_origin_os_body">In i Manager → App manager, allow VowiDroid to autostart, and under Settings → Battery allow its high background power consumption.</string>
    <string name="setup_rom_no_page">The ROM\'s page was not found; look under Settings → Battery.</string>
    <string name="setup_unknown">%1$s VowiDroid cannot read this setting back; tap to open the page.</string>
    <string name="setup_status_unknown">Not readable by VowiDroid</string>
    <string name="setup_contacts_title">Contacts</string>
    <string name="setup_contacts_body">Names and photos on calls and texts.</string>
    <string name="setup_conflict_title">Before you turn on WiFi Calling in VowiDroid</string>
    <string name="setup_conflict_body">VowiDroid registers the SIM with your carrier by itself. Turn off Wi-Fi calling for this SIM in Android\'s settings, so the phone and VowiDroid do not both register. Some carriers treat VowiDroid\'s tunnel as the phone moving its calling connection to Wi-Fi, so the phone\'s own VoLTE may stop working while VowiDroid\'s WiFi Calling is on.</string>
    <string name="setup_next_body">Then open Settings → Add a line in VowiDroid and choose the SIM.</string>
    <string name="setup_done_action">Done</string>

